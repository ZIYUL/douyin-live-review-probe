{
  "manifest_version": 3,
  "name": "抖音主播中心直播复盘数据探针",
  "version": "0.2.4.1",
  "minimum_chrome_version": "118",
  "permissions": [
    "debugger",
    "activeTab"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/popup.html"
  }
}
